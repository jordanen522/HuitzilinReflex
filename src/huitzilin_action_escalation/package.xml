<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>huitzilin_action_escalation</name>
  <version>0.1.0</version>
  <description>HuitzilinReflex — privacy-preserving aggressive-action escalation alerting. Independent of the projectile-evasion pipeline.</description>
  <maintainer email="j602eng1z@gmail.com">Jordan</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <!-- Camera Image only, for pose_detector_node. The projectile depth
       cloud on /oak/points stays off limits; test_isolation.py bans that
       topic by name, which is the guarantee that matters here. -->
  <depend>sensor_msgs</depend>

  <exec_depend>python3-yaml</exec_depend>
  <!-- Scenario and params files are resolved through the ament index. -->
  <exec_depend>ament_index_python</exec_depend>
  <!-- clock_guard only. Nothing else from huitzilin_sim is imported. -->
  <exec_depend>huitzilin_sim</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <!--
    DELIBERATELY ABSENT, and this is the isolation guarantee rather than a
    convenience: std_srvs, geometry_msgs, rcl_interfaces and
    huitzilin_perception.

    Without std_srvs there is no service client to /huitzilin/arm, /takeoff,
    /set_mode or /start_patrol. Without geometry_msgs there is no Twist, so
    /cmd/evade and /huitzilin/cmd_vel cannot be published. Adding any of them
    is a manifest edit, which is visible in every diff, as opposed to an
    import quietly appearing in a node file nobody rereads.

    This subsystem may drive lights and a siren. It may not fly the aircraft.
  -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
