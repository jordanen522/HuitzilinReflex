<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>huitzilin_sim</name>
  <version>0.2.0</version>
  <description>HuitzilinReflex — Week 2 sim stack: pymavlink bridge, patrol node, telemetry logger.</description>
  <maintainer email="j602eng1z@gmail.com">Jordan</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <!-- supervisor_node: PointCloud2 (sensor_msgs) and the SetParameters client
       it uses to retarget the bridge (rcl_interfaces). Both were imported
       without being declared, so rosdep fetched neither and the supervisor
       ImportErrored on a clean machine. -->
  <depend>sensor_msgs</depend>
  <depend>rcl_interfaces</depend>
  <!-- mav_bridge.py and patrol_node.py talk MAVLink directly. -->
  <exec_depend>python3-pymavlink</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>python3-numpy</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
