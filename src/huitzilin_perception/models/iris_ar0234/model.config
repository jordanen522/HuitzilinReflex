<?xml version="1.0"?>
<model>
  <name>iris_ar0234</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    iris_with_standoffs + forward-facing AR0234 global-shutter depth camera
    (See3CAM_20CUG + 10 mm M12). Resolution 800x650, HFOV 27.0 deg, 30 fps
    requested / ~23 Hz delivered, clip 0.2-35 m. No SDF noise: depth_noise_node
    applies the correlated range-dependent stereo error for this lane.
    Sensor frame: camera_optical_frame (Z-forward optical convention, REP-103).
  </description>
</model>
