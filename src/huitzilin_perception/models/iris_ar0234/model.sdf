<?xml version="1.0" ?>
<!--
  iris_ar0234 — iris_with_standoffs + the PROPOSED long-range depth camera.

  WHAT THIS IS FOR. iris_depth carries the OAK-D Lite the aircraft is actually
  built with, which resolves the 80 mm ball into 4 returns at 26 m — one under
  detector.yaml's cluster_min_points: 5. That is the measured mechanism behind
  its ~3.4 m practical reach, and the reason every 20 m/s result to date came
  through an asserted centroid (oracle) or a fabricated cloud
  (synthetic_depth). This model swaps in the optics that clear the floor, so
  the same range can be flown through the REAL detection pipeline.

  DERIVED FROM iris_depth/model.sdf BY COPY. Only the <sensor> block and the
  model name differ; the flight plugins are byte-identical and
  test_camera_models.py asserts it. They must be: iris_depth merge-includes the
  BARE iris_with_standoffs, which ships no flight plugins, and losing them
  gives SITL no FDM ("No JSON sensor message received") and the rotors no lift
  while Gazebo still steps and clouds still stream.

  USAGE
  -----
  Set GZ_SIM_RESOURCE_PATH to include this model's parent directory, then
  reference <uri>model://iris_ar0234</uri> in the world SDF.

  SENSOR SPECS (See3CAM_20CUG: AR0234 global-shutter mono + 10 mm M12)
  --------------------------------------------------------------------
  Resolution : 800 × 650
  Sector     : HFOV 27.0° (±13.5°), VFOV 22.1° (±11.0°)
  Frame rate : 30 fps requested, ~23 Hz DELIVERED (ros_gz_bridge is the
               ceiling — scripts/optics_probe). Quote the delivered rate.
  Range      : 0.2 – 35 m clip; 26 m modelled reach, ROI ceiling 27.2 m
  Returns    : ~24 on the ball at 26 m (measured, lab/probe_out/)
  Noise      : NONE in SDF — depth_noise_node.py owns it, correlated and
               range-dependent (σ = 0.30 m at 26 m, growing as z²)
  Mass       : the real part is 13.5 g against the OAK-D Lite's 61 g, so this
               is not a payload penalty. Geometry here is unchanged from
               iris_depth regardless: this model swaps optics, not airframe.

  FRAMES
  ------
  base_link
    └── camera_link          (mount offset: 0.10 m forward, 0.02 m up from CG)
          └── camera_optical_frame   (standard optical rotation: roll=-90°, yaw=-90°)

  The static TF for base_link→camera_link and camera_link→camera_optical_frame
  is published by the perception launch file (NOT by this SDF).  The sensor
  frame name here must match those TF frames exactly.
-->
<sdf version="1.9">
  <model name="iris_ar0234">

    <!-- ── Inherit the full iris_with_standoffs model ── -->
    <include merge="true">
      <uri>model://iris_with_standoffs</uri>
    </include>

    <!-- ── Camera mount link ── -->
    <link name="camera_link">
      <pose relative_to="base_link">0.10 0.0 0.02 0 0 0</pose>
      <inertial>
        <mass>0.030</mass>  <!-- 30 g (OAK-D Lite) -->
        <inertia>
          <ixx>1.0e-5</ixx><iyy>1.0e-5</iyy><izz>1.0e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <box><size>0.060 0.020 0.020</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="camera_collision">
        <geometry>
          <box><size>0.060 0.020 0.020</size></box>
        </geometry>
      </collision>

      <!-- ── Depth sensor (RGBD / depth_camera) ── -->
      <!--
        Gazebo Harmonic sensor type "depth_camera" publishes a depth image.
        The gz_ros2_bridge maps this to sensor_msgs/Image on /oak/depth and
        sensor_msgs/PointCloud2 on /oak/points (see params/bridge.yaml).

        NOTE: optical_frame_id only sets the header frame NAME.
        The point DATA stays in the gz sensor body frame (X-fwd, Y-left,
        Z-up) — the detector remaps to optical (cloud_convention: gz_flu).
      -->
      <sensor name="ar0234_depth" type="depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <!--
          30 Hz REQUESTED, ~23 Hz DELIVERED. scripts/optics_probe measured the
          ros_gz_bridge PointCloudPacked->PointCloud2 hop as the ceiling: no
          probed configuration ever reached its requested rate. 23 Hz is what
          t_dead = 0.155 + 1.380/f must be evaluated at, not 30.
        -->
        <update_rate>30</update_rate>
        <visualize>false</visualize>

        <camera name="depth">
          <!--
            See3CAM_20CUG (AR0234 global shutter mono) + 10 mm M12 lens.
            800x650 over 27.0 deg HFOV => +/-13.5 deg H, +/-11.0 deg V, which
            is the sector docs/RESULTS.md 5 quotes and the one
            synthetic_depth.py models. Angular resolution 0.0338 deg/px puts
            ~24 returns on the 80 mm ball at 26 m against cluster_min_points:
            5 -- MEASURED, in lab/probe_out/ar0234_800_26m.result.txt, not
            derived. The shipped OAK-D optics return 4 at the same range,
            one under the floor, which is the mechanism behind its ~3.4 m
            practical reach.
          -->
          <horizontal_fov>0.4712</horizontal_fov>  <!-- 27.0 deg in radians -->
          <image>
            <width>800</width>
            <height>650</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.2</near>
            <!--
              35 m, not iris_depth's 19.0 m. The clip must clear the modelled
              reach PLUS the depth noise's headroom: synthetic_depth's
              required_roi_max_range_m(26) is 27.2 m, because sigma grows as
              z^2 and a ceiling at the reach itself discards exactly the long
              draws that are a throw's FIRST detections. A 19 m clip would
              have manufactured a zero at 26 m with no error anywhere.
            -->
            <far>35.0</far>
          </clip>
          <!--
            NO <noise> TAG, deliberately. iris_depth carries a 1 cm gaussian
            one, which is both 30x too small at 26 m (the real figure is
            0.30 m) and structurally wrong: per-pixel independent noise smears
            the ball's cluster while averaging its centroid error down by
            ~sqrt(N), i.e. harder to find AND more accurate than the real part.
            depth_noise_node.py owns the error for this lane, so that
            sigma_ref_m: 0.0 is a genuinely noiseless control arm.
          -->
          <optical_frame_id>camera_optical_frame</optical_frame_id>
        </camera>

        <topic>/gz/oak_lr/depth</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
      </sensor>
    </link>

    <!-- Rigidly attach camera_link to base_link -->
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>


    <!-- ================================================================== -->
    <!-- Flight plugins.                                                     -->
    <!-- MUST stay here: iris_depth merge-includes the BARE                  -->
    <!-- iris_with_standoffs, which ships no flight plugins. Without these,  -->
    <!-- SITL gets no FDM ("No JSON sensor message received") and the rotors -->
    <!-- produce no lift. The "iris_with_standoffs::" prefix is stripped     -->
    <!-- because merge="true" flattens links/joints to the top level.        -->
    <!-- ================================================================== -->

    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <!-- LiftDrag: two per rotor -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda>
      <cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda>
      <cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda>
      <cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward>
      <link_name>rotor_1</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda>
      <cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward>
      <link_name>rotor_1</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda>
      <cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward>
      <link_name>rotor_2</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda>
      <cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward>
      <link_name>rotor_2</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda>
      <cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward>
      <link_name>rotor_3</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda>
      <cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward>
      <link_name>rotor_3</link_name>
    </plugin>

    <!-- ApplyJointForce: one per rotor joint -->
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>rotor_0_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>rotor_1_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>rotor_2_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>rotor_3_joint</joint_name>
    </plugin>

    <!-- ArduPilot JSON FDM link -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_link::imu_sensor</imuName>
      <control channel="0">
        <jointName>rotor_0_joint</jointName>
        <useForce>1</useForce><multiplier>838</multiplier><offset>0</offset>
        <servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <control channel="1">
        <jointName>rotor_1_joint</jointName>
        <useForce>1</useForce><multiplier>838</multiplier><offset>0</offset>
        <servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <control channel="2">
        <jointName>rotor_2_joint</jointName>
        <useForce>1</useForce><multiplier>-838</multiplier><offset>0</offset>
        <servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <control channel="3">
        <jointName>rotor_3_joint</jointName>
        <useForce>1</useForce><multiplier>-838</multiplier><offset>0</offset>
        <servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
    </plugin>
  </model>
</sdf>
